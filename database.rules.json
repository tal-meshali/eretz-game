{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.child('createdAt').exists() && newData.child('hostUid').exists() && newData.child('state').exists() && newData.child('config').exists()) || (!newData.exists() && data.child('createdAt').val() < now - 86400000))",
        "state": { ".write": "auth != null && data.parent().child('createdAt').exists()" },
        "config": { ".write": "auth != null && data.parent().child('createdAt').exists()" },
        "hostUid": { ".write": "auth != null && data.parent().child('createdAt').exists()" },
        "rounds": { ".write": "auth != null && data.parent().child('createdAt').exists()" },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.parent().parent().child('createdAt').exists()"
          }
        },
        "guesses": {
          ".write": "auth != null && !newData.exists()",
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.parent().parent().parent().child('createdAt').exists()"
            }
          }
        }
      }
    }
  }
}
